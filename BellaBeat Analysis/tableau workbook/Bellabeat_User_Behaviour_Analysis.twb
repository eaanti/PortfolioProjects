      <column caption='Activity Level' datatype='string' name='[Calculation_1368249889517953026]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [TotalSteps] &lt; 5000 THEN &quot;Low Activity&quot;&#13;&#10;ELSEIF [TotalSteps] &lt;= 9999 THEN &quot;Moderate Activity&quot;&#13;&#10;ELSE &quot;High Activity&quot;&#13;&#10;END' />
      </column>
      <column caption='Sedentary Level' datatype='string' name='[Calculation_1368249889519874051]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [SedentaryMinutes] &lt; 800 THEN &quot;Low Sedentary&quot;&#13;&#10;ELSEIF [SedentaryMinutes] &lt;= 1200 THEN &quot;Moderate Sedentary&quot;&#13;&#10;ELSE &quot;High Sedentary&quot;&#13;&#10;END' />
      </column>
      <column aggregation='Sum' caption='Activity Time' datatype='integer' name='[Calculation_1368249889524842501]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEPART(&apos;hour&apos;,[ActivityHour])' />
      </column>
      <column caption='Activity Time Label' datatype='string' name='[Calculation_1368249889525604358]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1368249889524842501] = 0 THEN &quot;12 AM&quot;&#13;&#10;&#13;&#10;ELSEIF [Calculation_1368249889524842501] &lt; 12 THEN&#13;&#10;STR([Calculation_1368249889524842501]) + &quot; AM&quot;&#13;&#10;&#13;&#10;ELSEIF [Calculation_1368249889524842501] = 12 THEN &quot;12 PM&quot;&#13;&#10;&#13;&#10;ELSE&#13;&#10;STR([Calculation_1368249889524842501] - 12) + &quot; PM&quot;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='User Segment' datatype='string' name='[Calculation_1368249889538318344]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [TotalSteps] &lt; 5000 THEN &quot;Sedentary&quot;&#13;&#10;&#13;&#10;ELSEIF [TotalSteps] &gt;= 5000 &#13;&#10;AND [TotalSteps] &lt;= 9999 THEN &quot;Moderately Active&quot;&#13;&#10;&#13;&#10;ELSE &quot;Highly Active&quot;&#13;&#10;&#13;&#10;END' />
